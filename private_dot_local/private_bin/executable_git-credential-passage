#!/usr/bin/env bash
# Minimal read-only Git credential helper backed by passage.
# Resolves "git/<host>": first line = password/token; optional
# "login: <user>" line = username.
set -euo pipefail

[ "${1:-}" = "get" ] || exit 0

declare -A req
while IFS="=" read -r key value; do
    [ -n "${key:-}" ] && req["$key"]="$value"
done

host="${req[host]:-}"
[ -n "$host" ] || exit 0

secret="$(passage show "git/$host" 2>/dev/null)" || exit 0
[ -n "$secret" ] || exit 0

password="$(printf '%s\n' "$secret" | head -n1)"
login="$(printf '%s\n' "$secret" | sed -n 's/^login: //p' | head -n1)"

[ -n "$password" ] && printf 'password=%s\n' "$password"
[ -n "$login" ] && printf 'username=%s\n' "$login"
