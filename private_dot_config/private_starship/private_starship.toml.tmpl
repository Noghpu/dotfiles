format = """
$env_var\
$os\
$username\
$hostname\
$directory\
{{ if ne .chezmoi.os "windows" -}}
$git_branch\
$git_status\
{{ end -}}
$fill\
$time\
$cmd_duration\
$line_break\
$character"""

palette = "catppuccin_mocha"

[palettes.catppuccin_mocha]
rosewater = "#f5e0dc"
flamingo = "#f2cdcd"
pink = "#f5c2e7"
mauve = "#cba6f7"
red = "#f38ba8"
maroon = "#eba0ac"
peach = "#fab387"
yellow = "#f9e2af"
green = "#a6e3a1"
teal = "#94e2d5"
sky = "#89dceb"
sapphire = "#74c7ec"
blue = "#89b4fa"
lavender = "#b4befe"
text = "#cdd6f4"
subtext1 = "#bac2de"
subtext0 = "#a6adc8"
overlay2 = "#9399b2"
overlay1 = "#7f849c"
overlay0 = "#6c7086"
surface2 = "#585b70"
surface1 = "#45475a"
surface0 = "#313244"
base = "#1e1e2e"
mantle = "#181825"
crust = "#11111b"

[os]
disabled = false
style = "lavender"

[os.symbols]
Windows = "\uE62A"
Ubuntu = "\U000F0548"
SUSE = "\uF314"
Raspbian = "\U000F043F"
Mint = "\U000F04ED"
Macos = "\U000F0035"
Manjaro = "\uF312"
Linux = "\U000F033D"
Gentoo = "\U000F04E8"
Fedora = "\U000F04DB"
Alpine = "\uF300"
Amazon = "\uF270"
Android = "\uF17B"
AOSC = "\uF301"
Arch = "\U000F04C7"
Artix = "\U000F04C7"
CentOS = "\uF304"
Debian = "\U000F04DA"
Redhat = "\U000F111B"
RedHatEnterprise = "\U000F111B"

[username]
show_always = true
style_user = "pink"
style_root = "red"
format = "[ $user]($style)"

[hostname]
ssh_only = true
style = "mauve"
format = "@[$hostname]($style) "

[directory]
style = "green"
format = " [$path]($style)"
truncation_length = 3
truncate_to_repo = true
truncation_symbol = "…/"

[directory.substitutions]
"Documents" = "\U000F0219 "
"Downloads" = "\uF019 "
"Music" = "\U000F075A "
"Pictures" = "\uF03E "
"Developer" = "\U000F04CB "

[env_var.TMUX]
symbol = "\uF489 "
style = "yellow"
default = ""
format = "([$symbol]($style))"

[env_var.ZMX_SESSION]
symbol = "\uf489 "
style = "mauve"
default = ""
format = '([$symbol(\($env_value\) )]($style))'

{{ if ne .chezmoi.os "windows" -}}
[git_branch]
style = "peach"
format = " [$symbol$branch]($style)"
symbol = ""

[git_status]
style = "yellow"
format = "[$all_status$ahead_behind]($style)"
ahead = "⇡${count}"
behind = "⇣${count}"
diverged = "⇕⇡${ahead_count}⇣${behind_count}"
conflicted = "="
untracked = "?"
stashed = "#"
modified = "!"
staged = "+"
renamed = "»"
deleted = "✘"

{{ end -}}
[fill]
disabled = true
symbol = " "

[time]
disabled = false
style = "sky"
format = "[ \uF017 $time]($style)"
time_format = "%R"

[cmd_duration]
style = "teal"
format = " [$duration]($style)"
min_time = 1000

[line_break]
disabled = false

[character]
success_symbol = "[❯](bold green)"
error_symbol = "[❯](bold red)"
