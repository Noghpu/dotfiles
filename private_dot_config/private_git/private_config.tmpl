[include]
    path = ~/.config/git/catppuccin.gitconfig

[core]
{{- if eq .chezmoi.os "windows" }}
    autocrlf = true
{{- else }}
    autocrlf = input
{{- end }}

{{ if lookPath "delta" -}}
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    features = catppuccin-mocha
    dark = true
    side-by-side = true
    line-numbers = true

{{ end -}}
{{ if lookPath "passage" -}}
# ~/.gitconfig does not exist, so `git config --global` writes into THIS file.
# Declaring the helper here keeps fish's conf.d/git-credentials.fish (which sets
# the same value) from leaving the chezmoi-managed file permanently modified.
# The helper binary itself is generated into ~/.local/bin by that fish snippet.
[credential]
    helper = passage

{{ end -}}
[merge]
    conflictstyle = zdiff3

{{ if lookPath "ec" -}}
# -- ec as your merge tool --
[merge]
    tool = ec
[mergetool "ec"]
    cmd = ec "$BASE" "$LOCAL" "$REMOTE" "$MERGED"
    trustExitCode = true
[mergetool]
    keepBackup = false
    prompt = false

{{ end -}}
{{ if lookPath "mergiraf" -}}
# -- mergiraf as a merge driver --
[merge "mergiraf"]
    name = mergiraf
    driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L

{{ end -}}
[pull]
    rebase = true

[init]
    defaultBranch = main

[diff]
    algorithm = histogram
