// Personal niri configuration — included last from config.kdl, so anything
// here supersedes it. Hand-maintained: nothing generates this file.
//
// Shell keybinds target Noctalia v5 IPC (`noctalia msg <command>`). The set
// below started as the DMS-generated defaults and was ported when CachyOS
// moved from DankMaterialShell to Noctalia.

input {
    keyboard {
        xkb {
            layout "us,ch"
            options "caps:swapescape"
        }
    }
}

layout {
    gaps 8
    center-focused-column "always"
    default-column-width { proportion 0.95; }

    focus-ring {
        width 2
        active-color "#cba6f7"
        inactive-color "#6c7086"
        urgent-color "#f38ba8"
    }

    border {
        width 2
        active-color "#b4befe"
        inactive-color "#45475a"
        urgent-color "#f38ba8"
    }
}

animations {
    window-open {
        duration-ms 50
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 50
        curve "ease-out-quad"
    }
    screenshot-ui-open {
        duration-ms 100
        curve "ease-out-quad"
    }
}

// On-demand VRR for the built-in panel: engages only when a window
// with variable-refresh-rate is fullscreen (e.g. games via gamescope),
// stays off on the desktop to avoid VRR brightness flicker.
output "eDP-1" {
    variable-refresh-rate on-demand=true
}

// Tone down the theme's 20 px window rounding.
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

// Keep GNOME windows a little squarer than the global rule.
window-rule {
    match app-id=r#"^org\.gnome\."#
    geometry-corner-radius 8
    clip-to-geometry true
}

// Dim inactive windows
window-rule {
    match is-active=false
    opacity 0.7
}

// Trigger VRR for games launched through gamescope.
window-rule {
    match app-id="^gamescope$"
    variable-refresh-rate true
}

// Youtube PiP
window-rule {
    match app-id="zen" title="^Picture-in-Picture$"

    open-floating true

    default-column-width { fixed 480; }
    default-window-height { fixed 270; }

    default-floating-position x=8 y=8 relative-to="bottom-right"
}

// Disable the built-in recent-window shortcuts; Super+Tab opens the overview.
recent-windows {
    binds {}
}

binds {
    // === System & Overview ===
    Mod+Tab repeat=false { toggle-overview; }
    Mod+Shift+Slash repeat=false {
        spawn "noctalia" "msg" "panel-toggle" "noghpu/niri-shortcuts:shortcuts";
    }

    // === Intentionally Unused ===
    // Persistent no-op overrides for personal and CachyOS bindings.
    Mod+Ctrl+Return repeat=false { spawn; }
    Mod+Alt+L repeat=false { spawn; }
    Mod+Shift+N repeat=false { spawn; }
    Mod+Ctrl+Shift+R repeat=false { spawn; }
    Mod+Ctrl+1 repeat=false { spawn; }
    Mod+Ctrl+2 repeat=false { spawn; }
    Mod+Ctrl+3 repeat=false { spawn; }
    Mod+Ctrl+4 repeat=false { spawn; }
    Mod+Ctrl+5 repeat=false { spawn; }
    Mod+Ctrl+6 repeat=false { spawn; }
    Mod+Ctrl+7 repeat=false { spawn; }
    Mod+Ctrl+8 repeat=false { spawn; }
    Mod+Ctrl+9 repeat=false { spawn; }
    Ctrl+Shift+1 repeat=false { spawn; }
    Ctrl+Shift+2 repeat=false { spawn; }
    Ctrl+Shift+3 repeat=false { spawn; }

    // === Application Launchers ===
    Mod+Return { spawn "kitty"; }
    Mod+Shift+Return repeat=false {
        spawn "session-launcher";
    }
    Mod+Space {
        spawn "noctalia" "msg" "panel-toggle" "launcher";
    }
    Mod+V {
        spawn "noctalia" "msg" "panel-toggle" "clipboard";
    }
    Mod+P {
        spawn "noctalia" "msg" "panel-toggle" "noghpu/passage:vault";
    }
    Mod+Comma {
        spawn "noctalia" "msg" "settings-toggle";
    }
    Mod+Y {
        spawn "noctalia" "msg" "panel-toggle" "wallpaper";
    }
    Mod+N {
        spawn "noctalia" "msg" "panel-toggle" "control-center" "notifications";
    }
    // Noctalia has no process-list surface; DMS's task manager maps to btop.
    Mod+M { spawn "kitty" "-e" "btop"; }
    Mod+B {
        spawn "sh" "-c" "if command -v zen-browser >/dev/null 2>&1; then exec zen-browser; else exec firefox; fi";
    }

    // === Security ===
    // Super+L stays free for rightward navigation, and Super+Escape stays
    // free for niri's shortcut-inhibit escape hatch.
    Mod+X {
        spawn "noctalia" "msg" "session" "lock";
    }
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete repeat=false hotkey-overlay-title="Session Menu" { spawn; }

    // === Audio Controls ===
    XF86AudioRaiseVolume allow-when-locked=true {
        spawn "noctalia" "msg" "volume-up" "3";
    }
    XF86AudioLowerVolume allow-when-locked=true {
        spawn "noctalia" "msg" "volume-down" "3";
    }
    XF86AudioMute allow-when-locked=true {
        spawn "noctalia" "msg" "volume-mute";
    }
    XF86AudioMicMute allow-when-locked=true {
        spawn "noctalia" "msg" "mic-mute";
    }

    // === Brightness Controls ===
    XF86MonBrightnessUp allow-when-locked=true {
       spawn "noctalia" "msg" "brightness-up" "5";
    }
    XF86MonBrightnessDown allow-when-locked=true {
       spawn "noctalia" "msg" "brightness-down" "5";
    }

    // === Window Management ===
    Mod+Q repeat=false { close-window; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+T { toggle-window-floating; }
    Mod+Shift+T { switch-focus-between-floating-and-tiling; }
    Mod+Shift+V repeat=false { spawn; }
    Mod+W repeat=false { spawn; }

    // === Focus Navigation ===
    Mod+H { focus-column-left; }
    Mod+J { focus-workspace-down; }
    Mod+K { focus-workspace-up; }
    Mod+L { focus-column-right; }
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-workspace-down; }
    Mod+Up    { focus-workspace-up; }
    Mod+Right { focus-column-right; }

    // === Window Movement ===
    Mod+Shift+H { move-column-left; }
    Mod+Shift+J { move-column-to-workspace-down; }
    Mod+Shift+K { move-column-to-workspace-up; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-column-to-workspace-down; }
    Mod+Shift+Up    { move-column-to-workspace-up; }
    Mod+Shift+Right { move-column-right; }

    // === Column Navigation ===
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Shift+Home { move-column-to-first; }
    Mod+Shift+End  { move-column-to-last; }
    Mod+Ctrl+Home repeat=false { spawn; }
    Mod+Ctrl+End repeat=false { spawn; }

    // === Monitor Navigation ===
    Mod+Ctrl+H     { focus-monitor-left; }
    Mod+Ctrl+J     { focus-monitor-down; }
    Mod+Ctrl+K     { focus-monitor-up; }
    Mod+Ctrl+L     { focus-monitor-right; }
    Mod+Ctrl+Left  { focus-monitor-left; }
    Mod+Ctrl+Down  { focus-monitor-down; }
    Mod+Ctrl+Up    { focus-monitor-up; }
    Mod+Ctrl+Right { focus-monitor-right; }

    // === Move to Monitor ===
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    // === Move Workspaces ===
    // Override CachyOS's power-off-monitors binding while leaving the key unused.
    Mod+Shift+P repeat=false hotkey-overlay-title=null { spawn; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    // === Mouse Wheel Navigation ===
    Mod+WheelScrollDown repeat=false { spawn; }
    Mod+WheelScrollUp repeat=false { spawn; }
    Mod+Ctrl+WheelScrollDown repeat=false { spawn; }
    Mod+Ctrl+WheelScrollUp repeat=false { spawn; }

    Mod+WheelScrollRight repeat=false { spawn; }
    Mod+WheelScrollLeft repeat=false { spawn; }
    Mod+Ctrl+WheelScrollRight repeat=false { spawn; }
    Mod+Ctrl+WheelScrollLeft repeat=false { spawn; }

    Mod+Shift+WheelScrollDown repeat=false { spawn; }
    Mod+Shift+WheelScrollUp repeat=false { spawn; }
    Mod+Ctrl+Shift+WheelScrollDown repeat=false { spawn; }
    Mod+Ctrl+Shift+WheelScrollUp repeat=false { spawn; }

    // === Numbered Workspaces ===
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    // === Move to Numbered Workspaces ===
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // === Column Management ===
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Period { expel-window-from-column; }

    // === Sizing & Layout ===
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { reset-window-height; }
    Mod+Ctrl+R repeat=false { spawn; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+C {
        spawn "noctalia" "msg" "panel-toggle" "control-center";
    }
    Mod+Ctrl+C repeat=false { spawn; }

    // === Manual Sizing ===
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // === Screenshots ===
    Mod+S { screenshot-window; }
    Print { screenshot-window; }
    Mod+Shift+S { screenshot; }
    Shift+Print { screenshot; }
    Mod+Ctrl+S { screenshot-screen; }
    Ctrl+Print { screenshot-screen; }

    // === System Controls ===
    Mod+Ctrl+P { power-off-monitors; }
}

include "arknights.kdl"
