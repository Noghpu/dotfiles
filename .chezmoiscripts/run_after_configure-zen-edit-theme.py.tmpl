#!/usr/bin/env python3

"""Apply the declared Zen Edit Theme to every Space."""

from __future__ import annotations

import configparser
import copy
import ctypes
import json
import os
from pathlib import Path
import shutil
import struct
import tempfile


MOZLZ4_MAGIC = b"mozLz40\0"
THEME_FILE = Path(
    r"{{ .chezmoi.sourceDir }}/private_dot_config/private_zen/private_edit-theme.json"
)


def find_profile(config_root: Path) -> Path | None:
    profiles_file = config_root / "profiles.ini"
    if not profiles_file.is_file():
        return None

    profiles = configparser.ConfigParser(interpolation=None)
    profiles.read(profiles_file)

    profile_path: str | None = None
    is_relative = True
    for section in profiles.sections():
        if section.startswith("Install") and profiles.has_option(section, "Default"):
            profile_path = profiles.get(section, "Default")
            break

    if profile_path is None:
        for section in profiles.sections():
            if not section.startswith("Profile"):
                continue
            if profiles.get(section, "Default", fallback="0") == "1":
                profile_path = profiles.get(section, "Path", fallback=None)
                is_relative = profiles.get(section, "IsRelative", fallback="1") == "1"
                break

    if not profile_path:
        return None

    path = Path(profile_path)
    return config_root / path if is_relative and not path.is_absolute() else path


def lz4_library() -> ctypes.CDLL:
    for library in ("liblz4.so.1", "liblz4.so"):
        try:
            return ctypes.CDLL(library)
        except OSError:
            pass
    raise RuntimeError("liblz4 is required to update Zen's session file")


def decode_mozlz4(encoded: bytes, liblz4: ctypes.CDLL) -> bytes:
    if not encoded.startswith(MOZLZ4_MAGIC) or len(encoded) < 12:
        raise ValueError("not a valid Mozilla JSONLZ4 file")

    decoded_size = struct.unpack_from("<I", encoded, 8)[0]
    compressed = encoded[12:]
    output = ctypes.create_string_buffer(decoded_size)
    source = ctypes.create_string_buffer(compressed)
    result = liblz4.LZ4_decompress_safe(
        source, output, len(compressed), decoded_size
    )
    if result < 0:
        raise ValueError("could not decompress Mozilla JSONLZ4 data")
    return output.raw[:result]


def encode_mozlz4(decoded: bytes, liblz4: ctypes.CDLL) -> bytes:
    capacity = liblz4.LZ4_compressBound(len(decoded))
    output = ctypes.create_string_buffer(capacity)
    source = ctypes.create_string_buffer(decoded)
    compressed_size = liblz4.LZ4_compress_default(
        source, output, len(decoded), capacity
    )
    if compressed_size <= 0:
        raise ValueError("could not compress Mozilla JSONLZ4 data")
    return MOZLZ4_MAGIC + struct.pack("<I", len(decoded)) + output.raw[:compressed_size]


def main() -> None:
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    profile = find_profile(config_home / "zen")
    if profile is None:
        return

    session_file = profile / "zen-sessions.jsonlz4"
    if not session_file.is_file():
        return

    theme = json.loads(THEME_FILE.read_text(encoding="utf-8"))
    liblz4 = lz4_library()
    original = session_file.read_bytes()
    session = json.loads(decode_mozlz4(original, liblz4))
    spaces = session.get("spaces", [])

    changed = False
    for space in spaces:
        if isinstance(space, dict) and space.get("theme") != theme:
            space["theme"] = copy.deepcopy(theme)
            changed = True

    if not changed:
        return

    backup = profile / "zen-sessions.pre-chezmoi.jsonlz4"
    shutil.copy2(session_file, backup)

    decoded = json.dumps(session, separators=(",", ":"), ensure_ascii=False).encode()
    updated = encode_mozlz4(decoded, liblz4)
    mode = session_file.stat().st_mode & 0o777

    temporary_name: str | None = None
    try:
        with tempfile.NamedTemporaryFile(dir=profile, delete=False) as temporary:
            temporary_name = temporary.name
            temporary.write(updated)
            temporary.flush()
            os.fsync(temporary.fileno())
        os.chmod(temporary_name, mode)
        os.replace(temporary_name, session_file)
        temporary_name = None
    finally:
        if temporary_name is not None:
            Path(temporary_name).unlink(missing_ok=True)


if __name__ == "__main__":
    main()
