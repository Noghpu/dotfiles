#!/usr/bin/env bash
set -euo pipefail

if ! command -v git >/dev/null 2>&1; then
    exit 0
fi

if command -v passage >/dev/null 2>&1; then
    # Keep the selected helper in the machine-local ~/.gitconfig. This avoids
    # modifying chezmoi's generated XDG Git configuration.
    mapfile -t helpers < <(git config --global --get-all credential.helper 2>/dev/null || true)
    if ((${#helpers[@]} != 1)) || [[ "${helpers[0]:-}" != passage ]]; then
        git config --global --unset-all credential.helper 2>/dev/null || true
        git config --global credential.helper passage
    fi
elif command -v git-credential-manager >/dev/null 2>&1 \
    && command -v gpg >/dev/null 2>&1 \
    && gpg --list-secret-keys --with-colons 2>/dev/null | grep -q '^sec:' \
    && [[ -d "$HOME/.password-store" ]]; then
    if [[ "$(git config --global credential.credentialStore 2>/dev/null || true)" != gpg ]]; then
        git config --global credential.credentialStore gpg
    fi
    if ! git config --global credential.helper 2>/dev/null | grep -q 'git-credential-manager'; then
        git-credential-manager configure
    fi
fi
